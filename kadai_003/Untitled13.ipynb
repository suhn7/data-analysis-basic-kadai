        "import numpy as np\n",
        "\n",
        "A = np.arange(6).reshape(3, 2)\n",
        "B = np.arange(8).reshape(2, 4)\n",
        "\n",
        "AB_dot = np.dot(A, B)\n",
        "print(AB_dot)\n",
        "\n",
        "AB_dot_max = AB_dot.max()\n",
        "print(AB_dot_max)"
